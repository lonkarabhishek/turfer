{
  "name": "tapturf-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:blog && tsc -p tsconfig.build-data.json && node .test-out/build-data/scripts/build.js",
    "build:data": "tsc -p tsconfig.build-data.json && node .test-out/build-data/scripts/build-data.js",
    "start": "next start",
    "lint": "eslint",
    "test:cricket": "tsc lib/cricket/overs.ts lib/cricket/nrr.ts lib/cricket/cricket.test.ts --module commonjs --target es2022 --moduleResolution node --outDir .test-out --skipLibCheck --esModuleInterop && node --test .test-out/cricket.test.js",
    "test:scorer": "tsc lib/cricket/overs.ts lib/cricket/scoring.ts lib/cricket/scoring.test.ts --rootDir . --module commonjs --target es2022 --moduleResolution node --outDir .test-out/scoring --skipLibCheck --esModuleInterop && node --test .test-out/scoring/lib/cricket/scoring.test.js &&tsc lib/cricket/overs.ts lib/cricket/scoring.ts components/tools/scorer/logic.ts components/tools/scorer/logic.test.ts components/tools/scorer/live.ts components/tools/scorer/live.test.ts --rootDir . --module commonjs --target es2022 --moduleResolution node --outDir .test-out/scorer-ui --skipLibCheck --esModuleInterop && node --test .test-out/scorer-ui/components/tools/scorer/logic.test.js .test-out/scorer-ui/components/tools/scorer/live.test.js",
    "test:city": "tsc lib/city.ts lib/cityRouting.ts lib/cityPrePaint.ts lib/sports.ts lib/cityRouting.test.ts lib/sports.test.ts --module commonjs --target es2022 --moduleResolution node --outDir .test-out --skipLibCheck --esModuleInterop && node --test .test-out/cityRouting.test.js .test-out/sports.test.js",
    "check:blog": "tsc -p tsconfig.check-blog.json && node .test-out/check-blog/scripts/check-blog.js",
    "test:names": "tsc -p tsconfig.test-names.json && node --test .test-out/names/lib/ai/names.test.js",
    "test:verified": "tsc -p tsconfig.test-verified.json && node --test .test-out/verified/lib/account/verified.test.js",
    "test:ask": "tsc -p tsconfig.test-ask.json && node --test .test-out/ask/lib/ai/quick.test.js .test-out/ask/lib/ai/relax.test.js .test-out/ask/lib/ai/facts.test.js .test-out/ask/lib/ask/chips.test.js .test-out/ask/lib/ask/cards.test.js .test-out/ask/lib/ask/project.test.js .test-out/ask/lib/ask/blog.test.js .test-out/ask/lib/ask/blogArticle.test.js .test-out/ask/lib/ask/svgSanitize.test.js .test-out/ask/lib/ask/artToken.test.js .test-out/ask/lib/ask/webLinks.test.js .test-out/ask/components/ask/blogUi.test.js",
    "test:cache": "tsc -p tsconfig.test-cache.json && node --test .test-out/cache/lib/cache/keys.test.js .test-out/cache/lib/cache/rowStore.test.js .test-out/cache/lib/cache/partRoute.test.js .test-out/cache/lib/supabase/guard.test.js .test-out/cache/lib/supabase/oneClient.test.js",
    "test:turf": "tsc -p tsconfig.test-turf.json && node --test .test-out/turf/lib/turfPage/turfPage.test.js .test-out/turf/lib/turfPage/managers.test.js .test-out/turf/lib/turfPage/owner.test.js .test-out/turf/lib/utils/prices.test.js .test-out/turf/lib/utils/cardSport.test.js .test-out/turf/lib/utils/images.test.js .test-out/turf/lib/utils/bookingApps.test.js .test-out/turf/lib/utils/hours.test.js",
    "test:game": "tsc -p tsconfig.test-game.json && node --test .test-out/game/lib/utils/game.test.js .test-out/game/lib/utils/sport.test.js .test-out/game/lib/utils/gameState.test.js .test-out/game/lib/utils/maps.test.js",
    "test:live": "tsc -p tsconfig.test-live.json && node --test .test-out/live/lib/live/codes.test.js .test-out/live/lib/live/server.test.js .test-out/live/lib/live/tags.test.js .test-out/live/components/live/follow.test.js .test-out/live/lib/live/gate.test.js .test-out/live/lib/admin/live.test.js",
    "test:board": "tsc lib/board/*.ts components/tools/board/logic.ts components/tools/board/storage.ts components/tools/board/logic.test.ts --rootDir . --strict --module commonjs --target es2022 --moduleResolution node --outDir .test-out/board --skipLibCheck --esModuleInterop && node --test .test-out/board/lib/board/*.test.js .test-out/board/components/tools/board/logic.test.js",
    "test:account": "tsc -p tsconfig.test-account.json && node --test .test-out/account/lib/account/account.test.js .test-out/account/lib/account/fresh.test.js .test-out/account/lib/account/link.test.js .test-out/account/lib/account/routes.test.js .test-out/account/lib/account/display.test.js .test-out/account/lib/auth/auth.test.js .test-out/account/lib/account/toolRoutes.test.js",
    "test:trend": "tsc -p tsconfig.test-trend.json && node --test .test-out/trend/lib/admin/trend.test.js .test-out/trend/lib/admin/people.test.js .test-out/trend/lib/admin/claims.test.js .test-out/trend/lib/admin/claimed.test.js .test-out/trend/lib/admin/links.test.js .test-out/trend/lib/admin/section.test.js .test-out/trend/lib/admin/home.test.js .test-out/trend/lib/admin/fetchGate.test.js .test-out/trend/lib/admin/readers.test.js",
    "test:photos": "tsc -p tsconfig.test-photos.json && node --test .test-out/photos/lib/my/photoMath.test.js .test-out/photos/lib/my/photoCheck.test.js",
    "test:my": "tsc -p tsconfig.test-my.json && node --test .test-out/my/lib/my/numbers.test.js",
    "test:reviews": "tsc -p tsconfig.test-reviews.json && node --test .test-out/reviews/lib/reviews/reviews.test.js .test-out/reviews/lib/reviews/routes.test.js",
    "test:toss":"tsc -p tsconfig.test-toss.json && node --test .test-out/toss/lib/tools/tossSim.test.js .test-out/toss/lib/tools/usage.test.js .test-out/toss/lib/tools/users.test.js",
    "test:ui": "tsc -p tsconfig.test-ui.json && node --test .test-out/ui/lib/ui/viewport.test.js",
    "test:seo": "tsc -p tsconfig.test-seo.json && node --test .test-out/seo/lib/seo/turfMeta.test.js .test-out/seo/lib/seo/listingMeta.test.js .test-out/seo/lib/seo/blogMeta.test.js .test-out/seo/lib/utils/seo.test.js .test-out/seo/lib/near/courtNearMe.test.js",
    "test:consent": "tsc -p tsconfig.test-consent.json && node --test .test-out/consent/lib/consent.test.js .test-out/consent/lib/analytics/consentGates.test.js .test-out/consent/lib/policy.test.js",
    "test:list": "tsc -p tsconfig.test-list.json && node --test .test-out/list/lib/turfList/query.test.js .test-out/list/lib/turfList/client.test.js",
    "test:build": "tsc -p tsconfig.test-build.json && node --test .test-out/build/lib/build/build.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.96.0",
    "firebase": "^12.9.0",
    "lucide-react": "^0.574.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
