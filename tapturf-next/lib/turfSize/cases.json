{
  "note": "Ground size rules, checked against lib/turfSize/sizes.ts normaliseGrounds (npm run test:turf) and, for the cases in feet with sql not false, against public.turf_ground_sizes_save (scripts/sql-tests/turf_dimensions.check.mjs). Inputs are what the owner typed; ok is what is stored (feet, to 0.1); problem names the ground and the box.",
  "cases": [
    { "what": "one box in feet", "unit": "ft", "grounds": [{ "name": "Box 1", "sport": "cricket", "length": 120, "width": 60, "height": 40 }],
      "ok": [{ "name": "Box 1", "sport": "cricket", "length_ft": 120, "width_ft": 60, "height_ft": 40 }] },
    { "what": "two boxes, decimals kept to 0.1 ft", "unit": "ft", "grounds": [{ "length": 110.25, "width": 55.04, "height": 35.06 }, { "name": "Box 2", "length": 90, "width": 45, "height": null }],
      "ok": [{ "name": null, "sport": null, "length_ft": 110.3, "width_ft": 55, "height_ft": 35.1 }, { "name": "Box 2", "sport": null, "length_ft": 90, "width_ft": 45, "height_ft": null }] },
    { "what": "an open ground: no height", "unit": "ft", "grounds": [{ "name": "Open ground", "sport": "football", "length": 200, "width": 120 }],
      "ok": [{ "name": "Open ground", "sport": "football", "length_ft": 200, "width_ft": 120, "height_ft": null }] },
    { "what": "width typed longer than length: swapped", "unit": "ft", "grounds": [{ "length": 60, "width": 120, "height": 30 }],
      "ok": [{ "name": null, "sport": null, "length_ft": 120, "width_ft": 60, "height_ft": 30 }] },
    { "what": "the limits themselves are fine", "unit": "ft", "grounds": [{ "length": 30, "width": 20, "height": 8 }, { "length": 400, "width": 250, "height": 120 }],
      "ok": [{ "name": null, "sport": null, "length_ft": 30, "width_ft": 20, "height_ft": 8 }, { "name": null, "sport": null, "length_ft": 400, "width_ft": 250, "height_ft": 120 }] },
    { "what": "a name is trimmed, spaces squeezed", "unit": "ft", "grounds": [{ "name": "  Big   box ", "length": 120, "width": 60 }],
      "ok": [{ "name": "Big box", "sport": null, "length_ft": 120, "width_ft": 60, "height_ft": null }] },
    { "what": "a blank name is no name", "unit": "ft", "grounds": [{ "name": "   ", "length": 120, "width": 60 }],
      "ok": [{ "name": null, "sport": null, "length_ft": 120, "width_ft": 60, "height_ft": null }] },
    { "what": "nothing: the owner removed every ground", "unit": "ft", "grounds": [], "ok": [] },

    { "what": "too short", "unit": "ft", "grounds": [{ "length": 29.9, "width": 20, "height": 20 }], "problem": { "ground": 0, "field": "length", "why": "range" } },
    { "what": "too long", "unit": "ft", "grounds": [{ "length": 401, "width": 60 }], "problem": { "ground": 0, "field": "length", "why": "range" } },
    { "what": "too narrow", "unit": "ft", "grounds": [{ "length": 120, "width": 19 }], "problem": { "ground": 0, "field": "width", "why": "range" } },
    { "what": "too wide even after the swap", "unit": "ft", "grounds": [{ "length": 300, "width": 260 }], "problem": { "ground": 0, "field": "width", "why": "range" } },
    { "what": "a swap that makes the length too long", "unit": "ft", "grounds": [{ "length": 100, "width": 410 }], "problem": { "ground": 0, "field": "length", "why": "range" } },
    { "what": "nets too low", "unit": "ft", "grounds": [{ "length": 120, "width": 60, "height": 7.9 }], "problem": { "ground": 0, "field": "height", "why": "range" } },
    { "what": "nets too high", "unit": "ft", "grounds": [{ "length": 120, "width": 60, "height": 121 }], "problem": { "ground": 0, "field": "height", "why": "range" } },
    { "what": "the second ground is the one with the problem", "unit": "ft", "grounds": [{ "length": 120, "width": 60 }, { "length": 120, "width": 10 }], "problem": { "ground": 1, "field": "width", "why": "range" } },
    { "what": "no length", "unit": "ft", "grounds": [{ "width": 60, "height": 30 }], "problem": { "ground": 0, "field": "length", "why": "missing" } },
    { "what": "no width", "unit": "ft", "grounds": [{ "length": 120 }], "problem": { "ground": 0, "field": "width", "why": "missing" } },
    { "what": "zero is not a size", "unit": "ft", "grounds": [{ "length": 0, "width": 60 }], "problem": { "ground": 0, "field": "length", "why": "number" } },
    { "what": "a name over 30 characters", "unit": "ft", "grounds": [{ "name": "The very big main box near the gate", "length": 120, "width": 60 }], "problem": { "ground": 0, "field": "name", "why": "long" } },
    { "what": "a phone number in a name", "unit": "ft", "grounds": [{ "name": "Call 98220 12345", "length": 120, "width": 60 }], "problem": { "ground": 0, "field": "name", "why": "phone" } },
    { "what": "a number that is no phone is fine in a name", "unit": "ft", "grounds": [{ "name": "Box 2 (7-a-side)", "length": 120, "width": 60 }],
      "ok": [{ "name": "Box 2 (7-a-side)", "sport": null, "length_ft": 120, "width_ft": 60, "height_ft": null }] },
    { "what": "a sport that is not cricket, football or both", "unit": "ft", "grounds": [{ "sport": "tennis", "length": 120, "width": 60 }], "problem": { "ground": 0, "field": "sport", "why": "sport" } },
    { "what": "five grounds", "unit": "ft", "grounds": [{ "length": 120, "width": 60 }, { "length": 120, "width": 60 }, { "length": 120, "width": 60 }, { "length": 120, "width": 60 }, { "length": 120, "width": 60 }], "problem": { "ground": -1, "field": "grounds", "why": "count" } },

    { "what": "metres become feet", "unit": "m", "sql": false, "grounds": [{ "name": "Box A", "length": 36.6, "width": 18.3, "height": 12.2 }],
      "ok": [{ "name": "Box A", "sport": null, "length_ft": 120.1, "width_ft": 60, "height_ft": 40 }] },
    { "what": "metres: a 30 m by 15 m open ground", "unit": "m", "sql": false, "grounds": [{ "length": 30, "width": 15 }],
      "ok": [{ "name": null, "sport": null, "length_ft": 98.4, "width_ft": 49.2, "height_ft": null }] },
    { "what": "metres: 9 m is under 30 ft", "unit": "m", "sql": false, "grounds": [{ "length": 9, "width": 7 }], "problem": { "ground": 0, "field": "length", "why": "range" } },
    { "what": "metres: 37 m of nets is over 120 ft", "unit": "m", "sql": false, "grounds": [{ "length": 40, "width": 20, "height": 37 }], "problem": { "ground": 0, "field": "height", "why": "range" } },
    { "what": "numbers as typed in the boxes", "unit": "ft", "sql": false, "grounds": [{ "length": "120", "width": " 60 ", "height": "35,5" }],
      "ok": [{ "name": null, "sport": null, "length_ft": 120, "width_ft": 60, "height_ft": 35.5 }] },
    { "what": "an empty height box is an open ground", "unit": "ft", "sql": false, "grounds": [{ "length": "120", "width": "60", "height": "" }],
      "ok": [{ "name": null, "sport": null, "length_ft": 120, "width_ft": 60, "height_ft": null }] },
    { "what": "words in a box", "unit": "ft", "sql": false, "grounds": [{ "length": "120ft", "width": "60" }], "problem": { "ground": 0, "field": "length", "why": "number" } }
  ]
}
